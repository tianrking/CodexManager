{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexManager",
  "version": "1.0.0",
  "identifier": "com.tianrking.codexmanager",
  "publisher": "tianrking",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Codex 多账号隔离管理器",
        "width": 880,
        "height": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
